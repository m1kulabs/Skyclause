    "@skyclause/auth": "workspace:*",
    "@skyclause/config": "workspace:*",
    "@skyclause/contracts": "workspace:*",
    "@skyclause/db": "workspace:*",
    "@skyclause/elements": "workspace:*",
    "@skyclause/forecast": "workspace:*",
    "@skyclause/i18n": "workspace:*",
    "@tailwindcss/postcss": "4.3.4",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
