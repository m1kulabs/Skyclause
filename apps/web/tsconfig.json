{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/types",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app",
    "app/.well-known/**/*.ts",
    "components",
    "features",
    "lib",
    "scripts",
    "test",
    "e2e",
    "instrumentation.ts",
    "next.config.ts",
    "playwright.config.ts"
  ],
  "references": [
    { "path": "../../packages/elements" },
    {
      "path": "../../packages/config"
    },
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/i18n"
    },
    {
      "path": "../../packages/auth"
    },
    {
      "path": "../../packages/api"
    },
    {
      "path": "../../packages/forecast"
    }
  ]
}
