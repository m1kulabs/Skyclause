{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verifyLedger request and response",
  "allOf": [
    {
      "$ref": "#/$defs/request"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["id"],
          "additionalProperties": false
        }
      },
      "required": ["params"],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": 200
            },
            "body": {
              "type": "object",
              "properties": {
                "valid": {
                  "type": "boolean"
                },
                "checked_entries": {
                  "type": "integer",
                  "minimum": 0
                },
                "first_bad_entry_id": {
                  "type": ["string", "null"]
                },
                "head_hash": {
                  "type": "string"
                },
                "verified_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "first_bad": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "seq": {
                      "type": "integer"
                    },
                    "reason": {
                      "type": "string",
                      "enum": ["seq_gap", "prev_hash", "hash"]
                    }
                  },
                  "required": ["id", "seq", "reason"]
                }
              },
              "required": ["valid", "checked_entries", "first_bad_entry_id", "head_hash", "verified_at"]
            }
          },
          "required": ["status", "body"],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-operationId": "verifyLedger",
  "x-method": "GET",
  "x-path": "/v1/projects/{id}/ledger/verify"
}
