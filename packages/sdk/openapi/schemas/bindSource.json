{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bindSource request and response",
  "allOf": [
    {
      "$ref": "#/$defs/request"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string"
            }
          },
          "required": ["source_id"]
        }
      },
      "required": ["params"],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": 201
            },
            "body": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "jps_rain",
                    "met_warning",
                    "met_forecast",
                    "apims",
                    "rapidrail_od",
                    "gtfs_static",
                    "gtfs_rt",
                    "golive",
                    "wikipedia",
                    "camera",
                    "pi"
                  ]
                },
                "external_id": {
                  "type": "string"
                },
                "owner_org_id": {
                  "type": ["string", "null"]
                },
                "name": {
                  "type": "string"
                },
                "lat": {
                  "type": ["number", "null"]
                },
                "lon": {
                  "type": ["number", "null"]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "cadence_s": {
                  "type": "integer"
                },
                "stale_after_s": {
                  "type": "integer"
                },
                "licence_id": {
                  "type": "string"
                },
                "licence_label": {
                  "type": "string"
                },
                "project_id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "rain_gauge",
                    "api_station",
                    "warnings",
                    "met_forecast",
                    "rail_station",
                    "venue_listings",
                    "bus_feed",
                    "gtfs_static",
                    "camera",
                    "pi"
                  ]
                },
                "state": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": ["fresh", "stale", "error", "recovered", "pending", "probation", "off_hours"]
                    },
                    "since": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "http_status": {
                      "type": ["integer", "null"]
                    },
                    "pending_until": {
                      "type": ["string", "null"],
                      "format": "date-time"
                    }
                  },
                  "required": ["state", "since", "http_status", "pending_until"]
                },
                "latest_reading": {
                  "type": ["object", "null"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "source_id": {
                      "type": "string"
                    },
                    "poll_id": {
                      "type": ["string", "null"]
                    },
                    "metric": {
                      "type": "string"
                    },
                    "unit": {
                      "type": ["string", "null"]
                    },
                    "observed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "received_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "value": {
                      "type": ["number", "null"]
                    },
                    "value_text": {
                      "type": ["string", "null"]
                    },
                    "value_json": {
                      "type": ["string", "number", "boolean", "object", "array", "null"]
                    },
                    "device_time": {
                      "type": ["string", "null"],
                      "format": "date-time"
                    },
                    "item_key": {
                      "type": ["string", "null"]
                    },
                    "revision": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "source_id",
                    "poll_id",
                    "metric",
                    "unit",
                    "observed_at",
                    "received_at",
                    "value",
                    "value_text",
                    "value_json",
                    "device_time",
                    "item_key",
                    "revision"
                  ]
                },
                "age_s": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "recent_errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "source_id": {
                        "type": "string"
                      },
                      "started_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "http_status": {
                        "type": ["integer", "null"]
                      },
                      "latency_ms": {
                        "type": "number"
                      },
                      "outcome": {
                        "type": "string"
                      },
                      "request_id": {
                        "type": "string"
                      },
                      "error_code": {
                        "type": ["string", "null"]
                      }
                    },
                    "required": [
                      "id",
                      "source_id",
                      "started_at",
                      "http_status",
                      "latency_ms",
                      "outcome",
                      "request_id",
                      "error_code"
                    ]
                  }
                },
                "probation": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string"
                    },
                    "probation": {
                      "type": "boolean"
                    },
                    "labeller_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "n": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "obscured_frames": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "agreement": {
                      "type": ["number", "null"],
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": ["source_id", "probation", "labeller_ids", "n", "obscured_frames", "agreement"]
                }
              },
              "required": [
                "id",
                "kind",
                "external_id",
                "owner_org_id",
                "name",
                "lat",
                "lon",
                "url",
                "cadence_s",
                "stale_after_s",
                "licence_id",
                "licence_label",
                "project_id",
                "role",
                "state",
                "latest_reading",
                "age_s",
                "recent_errors"
              ]
            }
          },
          "required": ["status", "body"],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-operationId": "bindSource",
  "x-method": "POST",
  "x-path": "/v1/projects/{id}/sources"
}
