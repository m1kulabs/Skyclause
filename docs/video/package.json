{
  "name": "@skyclause/video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "record": "playwright test -c record/playwright.config.ts",
    "record:check": "CHECK=1 playwright test -c record/playwright.config.ts",
    "voice": "bun scripts/voice.ts",
    "finish": "bash scripts/finish.sh"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/work-sans": "5.3.0",
    "@remotion/cli": "4.0.530",
    "@remotion/fonts": "4.0.530",
    "@remotion/media": "4.0.530",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
